    {
      "id": "c3320f0d-dd11-4783-84e1-9930da34916d",
      "name": "Extract Brand Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1240,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.fireworks.ai/inference/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "model": "accounts/fireworks/models/llama-v3p1-8b-instruct",
          "max_tokens": 2000,
          "temperature": 0.1,
          "messages": [
            {
              "role": "user",
              "content": "=You are a marketing analyst. Read the following website content and extract:\n1. Niche (industry/field)\n2. Main services (3-5 services)\n3. Target geographic region\n4. Brand name\n\nReply in JSON only:\n{\n  \"brand\": \"\",\n  \"niche\": \"\",\n  \"services\": [],\n  \"location\": \"\"\n}\n\nContent: {{ $('Scrape Website (Jina)').item.json.data }}"
            }
          ]
        }
      }
    },
    {
      "id": "9a76aeee-80a8-458e-9837-54c92ec23e99",
      "name": "Generate Questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1440,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.fireworks.ai/inference/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "model": "accounts/fireworks/models/llama-v3p1-8b-instruct",
          "max_tokens": 2000,
          "temperature": 0.3,
          "messages": [
            {
              "role": "user",
              "content": "=Based on the following information:\n- Brand Info: {{ $('Extract Brand Info').item.json.choices[0].message.content }}\n\nGenerate 10 realistic questions that potential customers would ask on search engines or AI tools when looking for this type of service.\n\nQuestions must be:\n- In Arabic or English depending on the target market\n- Realistic and specific\n- Varied (different services, different problems)\n\nReply in JSON only:\n{\"questions\": [\"question1\", \"question2\", ...]}"
            }
          ]
        }
      }
    },
    {
      "id": "d8aa8eb0-1d2e-49eb-8b04-58013613c1ae",
      "name": "Prepare Questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.3,
      "position": [
        1640,
        450
      ],
      "parameters": {
        "mode": "run_once_for_all_items",
        "jsCode": "// Parse the brand info and questions from Fireworks responses\nconst brandResponse = JSON.parse($json.choices[0].message.content);\nconst qsResponseRaw = $('Generate Questions').item.json.choices[0].message.content;\nconst qsResponse = JSON.parse(qsResponseRaw);\n\nconst brand = brandResponse.brand || '';\nconst niche = brandResponse.niche || '';\nconst services = brandResponse.services || [];\nconst location = brandResponse.location || '';\nconst questions = qsResponse.questions || [];\n\n// Return one item per question\nreturn questions.map((q, index) => ({\n  brand,\n  niche,\n  services: JSON.stringify(services),\n  location,\n  question: q,\n  questionIndex: index,\n  totalQuestions: questions.length\n}));"
      }
    },
    {
      "id": "c1fb7c09-08a6-4724-b038-c868ed6ad6f8",
      "name": "Calculate Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.3,
      "position": [
        2040,
        600
      ],
      "parameters": {
        "mode": "run_once_for_all_items",
        "jsCode": "// This receives all question results from the loop\nconst allResults = $input.all();\n\nlet totalMentions = 0;\nconst questionResults = [];\nconst competitorCounts = {};\n\nfor (const item of allResults) {\n  try {\n    const content = JSON.parse(item.json.choices[0].message.content);\n    const q = content.question || 'Unknown question';\n    const sources = content.sources || [];\n    \n    let qMentions = 0;\n    const sourceResults = [];\n    \n    for (const src of sources) {\n      const mentioned = src.mentioned_brand === true;\n      if (mentioned) qMentions++;\n      \n      if (src.mentioned_competitors) {\n        for (const comp of src.mentioned_competitors) {\n          competitorCounts[comp] = (competitorCounts[comp] || 0) + 1;\n        }\n      }\n      \n      sourceResults.push({\n        source: src.source,\n        mentioned: mentioned,\n        reason: src.failure_reason || '',\n        category: src.failure_category || '',\n        fix: src.fix || ''\n      });\n    }\n    \n    totalMentions += qMentions;\n    questionResults.push({\n      question: q,\n      mentions: qMentions,\n      sources: sourceResults\n    });\n  } catch(e) {\n    questionResults.push({\n      question: 'Error parsing result',\n      mentions: 0,\n      sources: []\n    });\n  }\n}\n\nconst totalTests = allResults.length * 3;\nconst score = totalTests > 0 ? Math.round((totalMentions / totalTests) * 100) : 0;\n\n// Find top competitor\nlet topCompetitor = 'None';\nlet topCount = 0;\nfor (const [name, count] of Object.entries(competitorCounts)) {\n  if (count > topCount) {\n    topCount = count;\n    topCompetitor = name;\n  }\n}\n\nreturn [{\n  score,\n  totalMentions,\n  totalTests,\n  topCompetitor,\n  questionResults: JSON.stringify(questionResults)\n}];"
      }
    },
    {
      "id": "5718e526-07ad-489f-b293-5ec19f5d6960",
      "name": "Format Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2240,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.fireworks.ai/inference/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "model": "accounts/fireworks/models/llama-v3p1-8b-instruct",
          "max_tokens": 3000,
          "temperature": 0.3,
          "messages": [
            {
              "role": "user",
              "content": "=Write a formatted GEO Visibility report to be sent via Telegram.\n\nData:\n- Score: {{ $json.score }}/100\n- Appeared in: {{ $json.totalMentions }} out of {{ $json.totalTests }} tests\n- Top competitor: {{ $json.topCompetitor }}\n- Question results: {{ $json.questionResults }}\n\nWrite the report in exactly this format (use emojis and dividers):\n\n🔍 GEO Visibility Report\n━━━━━━━━━━━━━━━\n📊 Score: [score]/100\n✅ Appeared in: [mentions] out of [total] tests\n🏆 Top competitor: [competitor]\n━━━━━━━━━━━━━━━\n📋 Question Breakdown:\n\n[For each question:]\n❓ [question]\n• ChatGPT: ✅/❌ | Perplexity: ✅/❌ | Gemini: ✅/❌\n• Why: [reason]\n• Fix: [specific fix]\n\n━━━━━━━━━━━━━━━\n📅 This Week's Priorities:\n1. [most important action]\n2. [second action]\n3. [third action]\n━━━━━━━━━━━━━━━\n💡 To re-analyze in a week, just send your URL again"
            }
          ]
        }
      }
    },
