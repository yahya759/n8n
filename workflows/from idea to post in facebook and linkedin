    {
      "parameters": {
        "jsCode": "function extractJson(rawText) {\n  // شيل أي code fence markdown (```json ... ```)\n  let cleaned = rawText.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n  // اعزل كائن الـ JSON من أول { لآخر }\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  let jsonStr = match ? match[0] : cleaned;\n\n  // محاولة أولى: بارسينغ مباشر\n  try {\n    return JSON.parse(jsonStr);\n  } catch (e) {\n    // إصلاح ذكي: الموديل أحياناً بيحط علامات اقتباس \" جوا النصوص بدون escape وهاي بتكسر الـ JSON.\n    // نصلحها: لكل حقل \"key\": \"value\" نستبدل أي اقتباس مزدوج داخل value باقتباس مفرد\n    // (الاقتباس الصحيح للحقل هو اللي بيجي مباشرة قبل فاصلة/قوس)\n    const repaired = jsonStr.replace(/(\"[a-zA-Z_]+\")(\\s*:\\s*\")([\\s\\S]*?)(\"(?=\\s*[,}]))/g, (m, key, sep, val, close) => {\n      const safeVal = val.replace(/\"/g, \"'\");\n      return key + sep + safeVal + close;\n    });\n    return JSON.parse(repaired);\n  }\n}\n\nconst raw = $json.output || $json.text || \"\";\nlet parsed = {};\ntry {\n  parsed = extractJson(raw);\n} catch (e) {\n  const topic = $(\"Extract Topic\").item.json.niche;\n  parsed = {\n    headline: topic,\n    linkedin_post: raw,\n    facebook_post: raw,\n    image_prompt: \"High-tech modern professional visual concept about \" + topic + \", cinematic lighting, 8k, photorealistic, no text\"\n  };\n}\n\nconst topic = $(\"Extract Topic\").item.json.niche;\nreturn [{\n  json: {\n    headline: parsed.headline || topic,\n    linkedin_post: parsed.linkedin_post || raw,\n    facebook_post: parsed.facebook_post || raw,\n    image_prompt: parsed.image_prompt || (\"Professional modern visual representing \" + topic + \", 8k, cinematic lighting, no text\"),\n    chat_id: $(\"Extract Topic\").item.json.chat_id\n  }\n}];"
      },
