      "id": "4c37c64d-ba71-4e92-bbd8-9fc8adbd23b7",
      "name": "Get New Conversations",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "analysis_results",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "analyzed_at",
              "condition": "gte",
              "keyValue": "={{ $today.startOf(\"week\").toISO() }}"
            }
          ]
        }
      },
      "id": "79f174d5-0a2f-4154-872d-a32db65a9a35",
      "name": "Get This Week Results",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        736,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst topicCounts = {};\nconst sentimentMap = { positive: 1, neutral: 0, negative: -1 };\nlet sentimentSum = 0;\nlet sentimentCount = 0;\nlet negativeCount = 0;\n\nfor (const item of items) {\n  const topic = item.json.topic || \"غير مصنف\";\n  topicCounts[topic] = (topicCounts[topic] || 0) + 1;\n  const s = (item.json.sentiment || \"\").toLowerCase();\n  if (sentimentMap[s] !== undefined) {\n    sentimentSum += sentimentMap[s];\n    sentimentCount += 1;\n  }\n  if (s === \"negative\") negativeCount += 1;\n}\n\nconst topTopics = Object.entries(topicCounts)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 10)\n  .map(([topic, count]) => ({ topic, count }));\n\nconst negativeRatio = items.length > 0 ? negativeCount / items.length : 0;\nconst alertTriggered = negativeRatio > 0.3;\n\nreturn [{\n  json: {\n    week_start: $today.startOf(\"week\").toISODate(),\n    top_topics: JSON.stringify(topTopics),\n    sentiment_score: sentimentCount > 0 ? sentimentSum / sentimentCount : 0,\n    negative_ratio: negativeRatio,\n    total_conversations: items.length,\n    alert_triggered: alertTriggered\n  }\n}];"
      },
      "id": "37d4aada-8a4f-4fa2-a2f9-b0cc33daf31c",
      "name": "Aggregate Weekly Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ]
    },
    {
