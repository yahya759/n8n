    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst now = new Date();\nconst todayStart = new Date(now);\ntodayStart.setHours(0, 0, 0, 0);\n\nconst yesterdayStart = new Date(todayStart);\nyesterdayStart.setDate(yesterdayStart.getDate() - 1);\n\nconst emails = rows.filter(row => {\n  if (row.sent_to_telegram === true) return false;\n  if (!row.received_at) return false;\n\n  const date = new Date(row.received_at);\n\n  return date >= yesterdayStart && date < todayStart;\n});\n\nemails.sort((a, b) => Number(b.priority || 0) - Number(a.priority || 0));\n\nconst urgent = emails.filter(e => e.category === 'urgent');\nconst followUp = emails.filter(e => e.category === 'follow_up');\nconst unimportant = emails.filter(e => e.category === 'unimportant');\n\nlet message = '📬 *ملخص إيميلاتك*\\n';\nmessage += '━━━━━━━━━━━━━━\\n';\nmessage += `📊 إجمالي الإيميلات: *${emails.length}*\\n\\n`;\n\nmessage += `🔴 *عاجل — ${urgent.length}*\\n`;\n\nif (urgent.length === 0) {\n  message += 'لا يوجد إيميلات عاجلة ✅\\n';\n} else {\n  urgent.forEach((email, index) => {\n    message += `\\n*${index + 1}. ${email.subject || 'بدون موضوع'}*\\n`;\n    message += `👤 ${email.sender || 'غير معروف'}\\n`;\n    message += `📝 ${email.summary || ''}\\n`;\n  });\n}\n\nmessage += `\\n🟡 *للمتابعة — ${followUp.length}*\\n`;\n\nif (followUp.length === 0) {\n  message += 'لا يوجد إيميلات للمتابعة.\\n';\n} else {\n  followUp.forEach((email, index) => {\n    message += `\\n*${index + 1}. ${email.subject || 'بدون موضوع'}*\\n`;\n    message += `👤 ${email.sender || 'غير معروف'}\\n`;\n    message += `📝 ${email.summary || ''}\\n`;\n  });\n}\n\nmessage += `\\n⚪ *غير مهم — ${unimportant.length}*\\n`;\n\nif (unimportant.length === 0) {\n  message += 'لا يوجد.\\n';\n} else {\n  unimportant.forEach((email, index) => {\n    message += `${index + 1}. ${email.subject || 'بدون موضوع'} — ${email.summary || ''}\\n`;\n  });\n}\n\nmessage += '\\n━━━━━━━━━━━━━━\\n';\nmessage += '🤖 *تم التلخيص والتصنيف بواسطة Groq AI*';\n\nreturn [\n  {\n    json: {\n      telegramMessage: message,\n      processedEmails: emails\n    }\n  }\n];"
      },
