    {
      "parameters": {
        "jsCode": "const original = $('Extract Email Data').first().json;\nconst aiOutput = $json.output || '';\n\nlet parsed;\n\ntry {\n  const cleaned = aiOutput\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {\n    category: 'follow_up',\n    summary: aiOutput.substring(0, 300),\n    priority: 2\n  };\n}\n\nreturn [\n  {\n    json: {\n      email_id: original.email_id,\n      sender: original.sender,\n      subject: original.subject,\n      summary: parsed.summary || 'لا يوجد ملخص',\n      category: parsed.category || 'follow_up',\n      priority: parsed.priority || 2,\n      received_at: original.received_at,\n      sent_to_telegram: false\n    }\n  }\n];"
      },
