      "notes": "لو Apify Actor اللي بتستخدمه اسمه مختلف، غيّر الرابط. تأكد إن الـ Actor بيرجع newest-first."
    },
    {
      "parameters": {
        "jsCode": "const reels = $input.all();\nif (!reels.length) {\n  return [];\n}\nconst latest = reels[0].json;\nreturn [{\n  json: {\n    username: latest.ownerUsername || latest.username || $('تكرار على كل حساب').first().json.username,\n    reel_id: String(latest.id || latest.shortCode || latest.url),\n    url: latest.url,\n    caption: latest.caption || '',\n    thumbnail: latest.displayUrl || latest.thumbnailUrl || latest.imageUrl,\n    timestamp: latest.timestamp\n  }\n}];"
      },
