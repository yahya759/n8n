    },
    {
      "parameters": {
        "jsCode": "const reel = $('تجهيز بيانات Supabase').first().json;\nconst gptRaw = $input.first().json;\nconst gpt = Array.isArray(gptRaw) ? gptRaw[0] : gptRaw;\nconst analysis = gpt?.content?.[0]?.text || gpt?.text || gpt?.choices?.[0]?.message?.content || 'تعذر التحليل';\nconst text = `🎯 ريلز جديد من @${reel.username}\\n\\n${analysis}\\n\\n🔗 ${reel.url}`;\nreturn [{ json: { text } }];"
      },
