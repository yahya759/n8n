    {
      "parameters": {
        "jsCode": "// بندمج بيانات الرسالة الأصلية مع نص الخدمات المنسق\n// (بنستخدم $('...') صراحة بدل الاعتماد على $json الضمني لأنو المصدر تغيّر بالفلو)\nconst rows = $input.all().map(item => item.json);\n\nconst lines = rows.map(r => `- ${r.name}: ${r.price} ريال (${r.duration_minutes} دقيقة)`);\nconst servicesText = lines.length ? lines.join('\\n') : 'لا توجد خدمات مسجلة حاليًا بالنظام.';\n\nconst originalData = $('استخراج بيانات الرسالة').first().json;\n\nreturn [\n  {\n    json: {\n      ...originalData,\n      services_text: servicesText\n    }\n  }\n];"
      },
