        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"كهرباء وإنارة\", \"مياه وصرف صحي\", \"سفلتة وطرق\", \"نظافة وبيئة\", \"حدائق ومرافق\", \"خدمات أخرى\"]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\"عالي\", \"متوسط\", \"منخفض\"]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"ملخص سطر واحد بالعربي\"\n    }\n  },\n  \"required\": [\"category\", \"urgency\", \"summary\"]\n}"
